{
  "id": "cs-resources",
  "name": "3 Resources for [Painpoint]",
  "niche": "AI",
  "description": "Hook states a painpoint to camera and pivots to the solution; three quick resource cards — white pill title/description overlays over screen recordings; follow CTA. Re-measured directly against the reference reel public/reels/cs-resources.mp4 (720x1280, 30fps): hook 2.933s, resources 1.633/1.667/1.900s, cta 1.467s — all hard cuts, no transitions.",
  "fps": 30,
  "width": 720,
  "height": 1280,
  "captionStyle": { "component": "Captions", "params": { "position": "lowerThird" } },
  "musicSlot": {
    "name": "music",
    "mediaType": "audio",
    "required": false,
    "instructions": "Optional music bed that you own or that is licensed to you. For posting, prefer adding trending audio inside Instagram/TikTok — it is licensed there and the render never bakes it in."
  },
  "musicVolume": 0.4,
  "blocks": [
    {
      "id": "hook",
      "title": "Hook",
      "kind": "broll",
      "videoSlot": "hook_clip",
      "brollDurationSec": 2.933,
      "slots": [
        {
          "name": "hook_clip",
          "mediaType": "video",
          "instructions": "B-roll/screen footage that plays under the painpoint text, phone vertical — e.g. a shot of a blank resume or an empty screen. No need to say anything on camera; the painpoint and pivot are shown as on-screen text instead."
        },
        {
          "name": "hook_text",
          "mediaType": "text",
          "instructions": "The painpoint as it should appear on screen, first person, in quotes, max two short lines."
        },
        {
          "name": "resolve_text",
          "mediaType": "text",
          "required": false,
          "instructions": "The short call that flashes right before the cut to resource 1 (the reference holds it for only ~0.33s). Default: GO HERE."
        }
      ],
      "events": [
        {
          "id": "hook_painpoint_overlay",
          "kind": "overlay",
          "component": {
            "component": "TextOverlay",
            "params": {
              "textSlot": "hook_text",
              "variant": "hook",
              "fontFamily": "poppins"
            }
          },
          "timing": { "kind": "fixed", "anchor": "blockStart", "offsetSec": 0 },
          "until": { "kind": "fixed", "anchor": "blockStart", "offsetSec": 2.6 },
          "layout": { "x": 0.05, "y": 0.42, "width": 0.9, "height": 0.38 }
        },
        {
          "id": "hook_resolve_overlay",
          "kind": "overlay",
          "component": {
            "component": "TextOverlay",
            "params": {
              "textSlot": "resolve_text",
              "variant": "resolve",
              "fontFamily": "poppins"
            }
          },
          "timing": { "kind": "fixed", "anchor": "blockStart", "offsetSec": 2.6 }
        }
      ]
    },
