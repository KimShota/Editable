          "example": "What do you think is heavier to carry?",
          "instructions": "Film yourself chest-up, casual and curious, asking the setup question straight to camera. Keep it short and let the last word hang."
        },
        {
          "name": "hook-text",
          "mediaType": "text",
          "required": true,
          "label": "Hook — question on screen",
          "example": "What do you think is HEAVIER to carry?",
          "instructions": "The big question shown at the top of the screen. Put the key word in CAPS to emphasize it."
