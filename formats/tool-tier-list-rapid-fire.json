{
  "id": "tool-tier-list-rapid-fire",
  "name": "[Category] Tier List: Bad, Good, Great",
  "niche": "Trending",
  "description": "A fast repeating structure where each beat names a use-case and ranks three options bad/good/great with pinned cards, cycling through several categories before a comment-bait CTA. Great for 'best tool per job' listicles.",
  "fps": 30,
  "width": 720,
  "height": 1280,
  "captionStyle": {
    "component": "Captions",
    "params": {
      "position": "lowerThird"
    }
  },
  "musicVolume": 0.5,
  "sharedSlots": [
    {
      "name": "cardPop",
      "mediaType": "audio",
      "required": false,
      "instructions": "A short punchy pop/whoosh sound that plays as each category's ranking cards appear. Keep it snappy (<0.3s)."
    }
  ],
  "blocks": [
    {
      "id": "cat-1",
      "title": "Category 1 (Hook)",
      "kind": "voice",
      "videoSlot": "clip1",
      "slots": [
        {
          "name": "clip1",
          "mediaType": "video",
          "required": true,
          "instructions": "Film yourself head-on, pointing up at the cards. Say your first use-case then rank three tools, e.g. 'For research, this is bad, this is okay, this one's amazing.' Start the line with the word 'For'."
        },
        {
          "name": "c1_bad",
          "mediaType": "image",
          "required": true,
          "instructions": "Logo/screenshot card of the WORST tool for this use-case. Include or leave room for a red 'BAD' label at the top."
        },
        {
          "name": "c1_good",
          "mediaType": "image",
          "required": true,
          "instructions": "Logo/screenshot card of the middling tool. Label it 'GOOD'."
        },
        {
          "name": "c1_great",
          "mediaType": "image",
          "required": true,
          "instructions": "Logo/screenshot card of the BEST tool. Label it 'GREAT'."
        }
      ],
      "captions": true,
      "captionVariant": "lowerThird",
      "backgroundReplace": false,
      "silhouette": false,
      "optional": false,
      "roles": [],
      "anchors": [
        {
          "id": "a1-for",
          "kind": "literal",
          "phrases": [
            "For research",
            "For",
            "When it comes to"
          ],
          "capture": true,
          "captureUntil": "this is",
