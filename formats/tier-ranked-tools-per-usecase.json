{
  "id": "tier-ranked-tools-per-usecase",
  "name": "BAD / GOOD / GREAT [Tools] For Every [Use Case]",
  "niche": "trending",
  "description": "For each use case the creator ranks three options worst-to-best while three top-of-frame cards (BAD/GOOD/GREAT) reveal their logos one at a time in sync with the speech, then a Follow + comment-keyword CTA.",
  "fps": 30,
  "width": 720,
  "height": 1280,
  "captionStyle": {
    "component": "Captions",
    "params": {
      "position": "lowerThird"
    }
  },
  "musicVolume": 0.5,
  "sharedSlots": [
    {
      "name": "cardPop",
      "mediaType": "audio",
      "required": false,
      "label": "Card reveal sound",
      "instructions": "A short, clean 'pop'/'whoosh' UI sound that fires each time a ranking card reveals its logo. Keep it snappy (<250ms) so three can fire in quick succession."
    }
  ],
  "blocks": [
    {
      "id": "usecase-research",
      "title": "Use Case 1 (Hook)",
      "kind": "voice",
      "videoSlot": "clip1",
      "slots": [
        {
          "name": "clip1",
          "mediaType": "video",
          "required": true,
          "label": "Use case 1 — spoken line",
          "example": "For research? This is bad, this is okay, this one's amazing.",
          "instructions": "Talking-head, centered, looking at camera with empty space above your head. Open by naming the first use case as a question, then rank three options worst-to-best. Point up-left, up-center, up-right in time with each so the cards feel tied to your gesture."
        },
        {
          "name": "badImg1",
          "mediaType": "image",
          "required": true,
          "label": "Use case 1 — BAD logo",
          "instructions": "Logo of the worst/most basic option for this use case, on a clean white rounded card (e.g. the outdated default everyone already uses)."
        },
        {
          "name": "goodImg1",
          "mediaType": "image",
          "required": true,
          "label": "Use case 1 — GOOD logo",
          "instructions": "Logo of the good/mainstream option for this use case, on a clean white rounded card."
