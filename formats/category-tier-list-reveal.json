{
  "id": "category-tier-list-reveal",
  "name": "[Category] Tier List",
  "niche": "Finance",
  "description": "A talking-head ranks several brands/items — filmed as one continuous take or as separate clips per item, plus a short separate clip of just the item names said back to back. Each item's logo pops in and drops into its S/A/B/C/D row on a tier board we draw for you, timed off you saying its name — no board or screenshot images to prepare, and nothing has to be said out loud for timing except each item's own name.",
  "fps": 30,
  "width": 720,
  "height": 1280,
  "captionStyle": {
    "component": "Captions",
    "params": {
      "position": "lowerThird"
    }
  },
  "musicVolume": 0.5,
  "sharedSlots": [
    {
      "name": "dropSfx",
      "mediaType": "audio",
      "required": false,
      "instructions": "A short punchy pop/thud that fires each time an item's logo lands in its tier row."
    }
  ],
  "namesTakeSlot": {
    "name": "namesTake",
    "mediaType": "video",
    "required": true,
    "label": "Names take",
    "instructions": "One clip, nothing else: say each item's name back to back, in the SAME order as items 1-6 below, with a clear pause between each name. We pull out just each name and use it to time that item's reveal — you don't need to say the tier out loud, that's what the pickers below are for."
  },
  "blocks": [
    {
      "id": "item-1",
      "title": "Hook + First Item",
      "kind": "voice",
      "videoSlot": "talk1",
      "slots": [
        {
          "name": "talk1",
          "mediaType": "video",
          "required": true,
          "label": "Item 1 — your take",
          "instructions": "Medium selfie shot, hold steady. Talk about your first item — its weaknesses, why it earned a low tier. No need to lead with its name or tier; your names take handles the reveal timing."
        },
        {
          "name": "titleText",
          "mediaType": "text",
          "required": true,
          "instructions": "The video's title, bracketing your niche, e.g. '🇨🇦 Bank Tier List' or '[Category] Tier List'. Rendered on a white pill top-center."
        },
        {
          "name": "subtitleText",
          "mediaType": "text",
          "required": false,
          "instructions": "A short qualifier line under the title, e.g. '($100k+ net worth, has 3 bank accounts)'."
        },
        {
          "name": "tier1",
          "mediaType": "text",
          "required": true,
          "label": "Item 1 — tier",
          "instructions": "Which row this item's logo drops into.",
          "control": {
            "kind": "choice",
            "options": [
              {
                "value": "S",
                "color": "#FF7F7F"
              },
              {
                "value": "A",
                "color": "#FFBF7F"
              },
              {
                "value": "B",
                "color": "#FFDF7F"
              },
              {
                "value": "C",
                "color": "#7FFF7F"
              },
              {
                "value": "D",
                "color": "#7FFFFF"
              }
            ]
          }
        },
        {
          "name": "name1",
          "mediaType": "text",
          "required": false,
          "label": "Item 1 — name",
          "instructions": "The item's display name, shown next to its icon on the tier board. Auto-filled from your names take — edit here only if we misheard it."
        },
        {
          "name": "logo1",
          "mediaType": "image",
          "required": true,
          "label": "Item 1 — logo",
          "instructions": "Transparent PNG logo of this item."
        }
      ],
      "captions": true,
      "captionVariant": "lowerThird",
      "backgroundReplace": false,
      "silhouette": false,
      "optional": false,
      "roles": [],
      "anchors": [],
