        {
          "id": "name-cutaway-2",
          "kind": "overlay",
          "component": { "component": "CutawayOverlay", "params": { "videoSlot": "bshot-name-2" } },
          "timing": { "kind": "sequence", "roleId": "name-marker", "edge": "captureStart", "index": 1, "count": 2, "targetGapSec": 0.9, "minGapSec": 0.45 },
          "durationSec": 0.45
        }
      ],
      "transitionAfter": {
        "component": "cut",
        "params": { "durationSec": 0 }
      }
    },
    {
