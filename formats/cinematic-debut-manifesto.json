          "name": "bshot-name-1",
          "mediaType": "video",
          "required": true,
          "instructions": "Auto-generated — no filming needed.",
          "generation": { "kind": "plateStill", "shot": "dark side-profile silhouette on a white studio backdrop", "durationSec": 0.55, "seed": 0, "plate": "studio-cyc", "treatment": "silhouette", "poseTag": "profile" }
