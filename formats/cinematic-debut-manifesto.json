{
  "id": "cinematic-debut-manifesto",
  "name": "The [Profession] Debut Manifesto",
  "niche": "any person launching a personal brand / creator account in a specific field (finance, fitness, law, cooking, etc.) who wants a dramatic trailer-style intro",
  "description": "A talking-head delivers a line-by-line self-introduction — a bold audience call-out, name reveal, credential, and outrageous ambition — with each beat punched by a single giant word overlay and intercut with moody silhouette b-roll, resolving into a dramatic music montage, a detail triptych, an optional comedic follow-CTA, and a full-screen title card.",
  "fps": 30,
  "width": 720,
  "height": 1280,
  "captionStyle": {
    "component": "Captions",
    "params": {
      "position": "lowerThird",
      "theme": "kumar"
    }
  },
  "musicVolume": 0.55,
  "musicSlot": {
    "name": "dramatic-music",
    "mediaType": "audio",
    "required": false,
    "instructions": "A tense, building cinematic/trailer track. Should swell right as the spoken intro ends and carry the montage. Leave blank to use the format's own default score."
  },
  "musicPlacement": {
    "mode": "montageOnset",
    "fadeInSec": 0.3,
    "fadeOutSec": 0.7,
    "duckVolume": 0.32
  },
  "speakingTakeSlot": {
    "name": "speaking-take",
    "mediaType": "video",
    "required": true,
    "instructions": "One continuous take of all your lines, straight to camera. Say each line clearly with a brief pause between them — the office background, cutaways, and montage are added for you automatically."
  },
  "identitySlot": {
    "name": "identity-photos",
    "mediaType": "image",
    "required": true,
    "instructions": "5+ clear, well-lit photos of your face and body — standing (arms crossed), a close-up, a side/three-quarter angle, and at least one seated pose. These are automatically composited into real studio and couch shots in Kumar's cinematic style, so you don't have to film them yourself."
  },
  "blocks": [
    {
      "id": "hook",
      "title": "Hook — call out your audience",
      "kind": "voice",
      "videoSlot": "hook-clip",
      "backgroundReplace": true,
      "slots": [
        {
          "name": "hook-clip",
          "mediaType": "video",
          "required": true,
          "instructions": "Sit at a desk, hands steepled, and say slowly and gravely: 'This is a message to all [your audience]' — e.g. 'to all finance pros', 'to all personal trainers'. Deliver it like a threat, not a greeting. Lighting/background are replaced automatically — just say the line."
        },
        {
          "name": "bshot-hook-1",
          "mediaType": "video",
          "required": true,
          "instructions": "Auto-generated — no filming needed.",
          "generation": { "kind": "plateStill", "shot": "silhouette pensive portrait on a white studio backdrop, arms crossed", "durationSec": 0.55, "seed": 0, "plate": "studio-cyc", "treatment": "silhouette", "poseTag": "standing" }
        },
        {
          "name": "bshot-hook-2",
          "mediaType": "video",
          "required": true,
          "instructions": "Auto-generated — no filming needed.",
          "generation": { "kind": "plateStill", "shot": "moody silhouette seated on a dark leather couch", "durationSec": 0.55, "seed": 0, "plate": "sofa", "treatment": "silhouette", "poseTag": "sitting" }
        }
      ],
      "captions": true,
      "roles": [],
      "anchors": [
        {
          "id": "hook-marker",
          "kind": "literal",
          "phrases": [
            "This is a message to all",
            "This is a message to",
            "This is a message for"
          ],
          "capture": true,
          "fallback": {
            "anchor": "blockStart",
            "offsetSec": 0.1
          }
        }
      ],
      "events": [
        {
          "id": "hook-cutaway-1",
          "kind": "overlay",
          "component": { "component": "CutawayOverlay", "params": { "videoSlot": "bshot-hook-1" } },
          "timing": { "kind": "sequence", "roleId": "hook-marker", "edge": "captureStart", "index": 0, "count": 2, "targetGapSec": 0.95, "minGapSec": 0.5 },
          "durationSec": 0.5
        },
        {
          "id": "hook-cutaway-2",
          "kind": "overlay",
          "component": { "component": "CutawayOverlay", "params": { "videoSlot": "bshot-hook-2" } },
          "timing": { "kind": "sequence", "roleId": "hook-marker", "edge": "captureStart", "index": 1, "count": 2, "targetGapSec": 0.95, "minGapSec": 0.5 },
          "durationSec": 0.5
        }
      ],
      "transitionAfter": {
        "component": "cut",
        "params": { "durationSec": 0 }
      }
    },
    {
      "id": "name-reveal",
      "title": "Name reveal",
      "kind": "voice",
