      "events": [
        {
          "id": "name-cutaway-1",
          "kind": "overlay",
          "component": { "component": "CutawayOverlay", "params": { "videoSlot": "bshot-name-1" } },
          "timing": { "kind": "sequence", "roleId": "name-marker", "edge": "captureStart", "index": 0, "count": 2, "targetGapSec": 0.9, "minGapSec": 0.45 },
          "durationSec": 0.45
