{
  "id": "cinematic-debut-manifesto",
  "name": "The [Profession] Debut Manifesto",
  "niche": "any person launching a personal brand / creator account in a specific field (finance, fitness, law, cooking, etc.) who wants a dramatic trailer-style intro",
  "description": "A talking-head delivers a line-by-line self-introduction — a bold audience call-out, name reveal, credential, and outrageous ambition — with each beat punched by a single giant word overlay and intercut with moody silhouette b-roll, resolving into a dramatic music montage and a full-screen title card.",
  "fps": 30,
  "width": 720,
  "height": 1280,
  "captionStyle": {
    "component": "Captions",
    "params": {
      "position": "lowerThird",
      "theme": "kumar"
    }
  },
  "musicVolume": 0.5,
  "speakingTakeSlot": {
    "name": "speaking-take",
    "mediaType": "video",
    "required": true,
    "instructions": "One continuous take of all your lines, straight to camera. Say each line clearly with a brief pause between them — cutaways and the montage are added for you separately."
  },
  "identitySlot": {
    "name": "identity-photos",
    "mediaType": "image",
    "required": true,
    "instructions": "3+ clear, well-lit photos of your face and body: one front-on, one side profile, one close-up. These are used to automatically generate the silent montage shot in Kumar's cinematic style, so you don't have to film it yourself."
  },
  "sharedSlots": [
    {
      "name": "dramatic-music",
      "mediaType": "audio",
      "required": false,
      "instructions": "A tense, building cinematic/trailer track. Should swell right as the spoken intro ends and carry the silent montage."
    }
  ],
  "blocks": [
    {
      "id": "hook",
      "title": "Hook — call out your audience",
      "kind": "voice",
      "videoSlot": "hook-clip",
      "backgroundReplace": true,
      "ecuCutaway": {
        "atSec": 0.2,
        "durationSec": 0.4,
        "overlayAtSec": 0.9
      },
      "slots": [
        {
          "name": "hook-clip",
          "mediaType": "video",
          "required": true,
          "instructions": "Sit at a desk framed like an office/authority setting (e.g. a wall map or shelf behind you), lit dark and moody. Look straight into the lens, hands steepled, and say slowly and gravely: 'This is a message to all [your audience]' — e.g. 'to all finance pros', 'to all personal trainers'. Deliver it like a threat, not a greeting."
        },
        {
          "name": "hook-cutaway-clip",
          "mediaType": "video",
          "required": true,
          "instructions": "Auto-generated — no filming needed.",
          "generation": {
            "kind": "montage",
            "shot": "backlit silhouette portrait, high contrast, still pose, plain light backdrop",
            "durationSec": 0.8,
            "seed": 2
          }
        }
      ],
      "captions": true,
      "roles": [],
      "anchors": [
        {
          "id": "hook-marker",
          "kind": "literal",
          "phrases": [
            "This is a message to all",
            "This is a message to",
            "This is a message for"
          ],
          "capture": true,
          "fallback": {
            "anchor": "blockStart",
            "offsetSec": 0.1
          }
        }
      ],
      "events": [
        {
          "id": "hook-cutaway",
          "kind": "overlay",
          "component": {
            "component": "CutawayOverlay",
            "params": {
              "videoSlot": "hook-cutaway-clip"
            }
          },
          "timing": {
            "kind": "role",
            "roleId": "hook-marker",
            "edge": "captureStart",
            "offsetSec": 0.05
          },
          "durationSec": 0.8
        }
      ],
      "transitionAfter": {
        "component": "cut",
        "params": {
          "durationSec": 0
        }
      }
    },
    {
      "id": "name-reveal",
      "title": "Name reveal",
      "kind": "voice",
      "videoSlot": "name-clip",
      "backgroundReplace": true,
      "slots": [
        {
          "name": "name-clip",
          "mediaType": "video",
          "required": true,
          "instructions": "Same dark desk framing, calm and confident. Say: 'My name is [your name].' Pause on your name so the big word can hit."
        },
        {
          "name": "name-cutaway-clip",
          "mediaType": "video",
          "required": true,
          "instructions": "Auto-generated — no filming needed.",
          "generation": {
            "kind": "montage",
            "shot": "backlit silhouette portrait, high contrast, still pose, plain light backdrop",
            "durationSec": 0.6,
            "seed": 3
          }
        }
      ],
      "captions": true,
      "captionVariant": "bigTitle",
      "roles": [],
      "anchors": [
        {
          "id": "name-marker",
          "kind": "literal",
          "phrases": [
            "My name is",
            "The name is",
            "I'm",
            "I am"
          ],
          "capture": true,
          "fallback": {
            "anchor": "blockStart",
            "offsetSec": 0.4
          }
        }
      ],
      "events": [
        {
          "id": "name-cutaway",
          "kind": "overlay",
          "component": {
            "component": "CutawayOverlay",
            "params": {
              "videoSlot": "name-cutaway-clip"
            }
          },
          "timing": {
            "kind": "role",
            "roleId": "name-marker",
            "edge": "captureStart",
            "offsetSec": 0.1
          },
          "durationSec": 0.6
        }
      ],
      "transitionAfter": {
        "component": "cut",
        "params": {
          "durationSec": 0
        }
      }
    },
    {
      "id": "credential",
      "title": "Credential",
      "kind": "voice",
      "videoSlot": "credential-clip",
      "backgroundReplace": true,
      "slots": [
        {
          "name": "credential-clip",
          "mediaType": "video",
          "required": true,
          "instructions": "Same setup. State your background in one short phrase: 'I'm a [credential]' — e.g. 'a retired accountant', 'a former lawyer'. Land hard on the key title word."
        }
      ],
      "captions": true,
      "captionVariant": "bigTitle",
      "roles": [],
      "anchors": [
        {
          "id": "cred-marker",
          "kind": "literal",
          "phrases": [
            "I'm a",
            "I am a",
            "I'm an",
            "I am an"
          ],
          "capture": true,
          "fallback": {
            "anchor": "blockStart",
            "offsetSec": 0.3
          }
        }
      ],
      "events": [],
      "transitionAfter": {
        "component": "cut",
        "params": {
          "durationSec": 0
        }
      }
    },
    {
      "id": "bold-claim",
      "title": "The outrageous ambition",
      "kind": "voice",
      "videoSlot": "claim-clip",
      "backgroundReplace": true,
      "punchInTailSec": 0.9,
      "slots": [
        {
          "name": "claim-clip",
          "mediaType": "video",
          "required": true,
          "instructions": "Same dark desk. Deliver your grand, slightly over-the-top mission in one breath: 'And I'm gonna [take over / become the biggest X in the world]'. Escalate your intensity toward the end."
        },
        {
          "name": "claim-cutaway-clip",
          "mediaType": "video",
          "required": true,
          "instructions": "Auto-generated — no filming needed.",
          "generation": {
            "kind": "montage",
            "shot": "backlit silhouette portrait, high contrast, still pose, plain light backdrop",
            "durationSec": 0.7,
            "seed": 4
          }
        }
      ],
      "captions": true,
      "captionVariant": "bigTitle",
      "roles": [],
      "anchors": [
        {
          "id": "claim-marker",
          "kind": "literal",
          "phrases": [
            "And I'm gonna",
            "And I'm going to",
            "I'm gonna",
            "I am going to"
          ],
          "capture": false,
          "fallback": {
            "anchor": "blockStart",
            "offsetSec": 0
          }
        }
      ],
      "events": [
        {
          "id": "claim-cutaway",
          "kind": "overlay",
          "component": {
            "component": "CutawayOverlay",
            "params": {
              "videoSlot": "claim-cutaway-clip"
            }
          },
          "timing": {
            "kind": "role",
            "roleId": "claim-marker",
            "edge": "end",
            "offsetSec": 1.3
          },
          "durationSec": 0.7
        }
      ],
      "transitionAfter": {
        "component": "whooshZoom",
        "params": {
          "durationSec": 0.4
        }
      }
    },
    {
      "id": "cinematic-montage",
      "title": "Silent dramatic montage",
      "kind": "broll",
      "videoSlot": "montage-clip",
      "slots": [
        {
          "name": "montage-clip",
          "mediaType": "video",
          "required": true,
          "instructions": "Generated automatically from your identity photos in Kumar's cinematic style (backlit silhouette, moody, high contrast). Supply your own clip here instead if you'd rather film this shot yourself.",
          "generation": {
            "kind": "montage",
            "shot": "backlit silhouette portrait, high contrast, subject slowly turns toward camera in a moody thinking pose, arms crossed, plain dark backdrop",
            "durationSec": 5,
            "seed": 1
          }
        }
      ],
      "captions": false,
      "roles": [],
      "anchors": [],
      "events": [
        {
          "id": "montage-music",
          "kind": "sfx",
          "component": {
            "component": "Sfx",
            "params": {
              "audioSlot": "dramatic-music",
              "volume": 0.9
            }
          },
          "timing": {
            "kind": "fixed",
            "anchor": "blockStart",
            "offsetSec": 0
          }
        }
      ],
      "transitionAfter": {
        "component": "cut",
        "params": {
          "durationSec": 0
        }
      }
    },
    {
      "id": "end-card",
      "title": "Title card",
      "kind": "broll",
      "videoSlot": "endcard-clip",
      "brollDurationSec": 2.2,
      "silhouette": true,
      "slots": [
        {
          "name": "endcard-clip",
          "mediaType": "video",
          "required": true,
          "instructions": "Full-body shot against a plain seamless backdrop, standing still and confident (arms crossed), holding the pose for ~2s. Leave clear space at the top and bottom of frame for the title text."
        },
        {
          "name": "debut-title",
          "mediaType": "text",
          "required": true,
          "instructions": "The title-card text, e.g. \"[NAME]'S DEBUT\". Keep it short and dramatic, ALL CAPS."
        }
      ],
      "captions": false,
      "roles": [],
      "anchors": [],
      "events": [
        {
          "id": "endcard-title-overlay",
          "kind": "overlay",
          "component": {
            "component": "TextOverlay",
            "params": {
              "textSlot": "debut-title",
              "variant": "kumarTitle",
              "fontSize": 100
            }
          },
          "timing": {
            "kind": "fixed",
            "anchor": "blockStart",
            "offsetSec": 0
          }
        }
      ]
    }
  ]
}