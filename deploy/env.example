# Copy to /opt/editable/.env and fill in. chmod 600 — it holds live keys.
#
# systemd reads this file directly (see editable.service), so keep it to
# plain KEY=value with no `export`, no inline comments, and no shell
# interpolation.

# --- Required ---------------------------------------------------------

# Neon connection string. The same database the Mac used — accounts,
# sessions, invites and job ownership all live here, so pointing the server
# at it carries every existing login over.
DATABASE_URL=

# Role resolution + transcript correction. Without it the pipeline falls
# back to config positions and skips correction entirely (resolvers/index.ts
# pickResolver/pickCorrector), which quietly degrades every build.
ANTHROPIC_API_KEY=

# Per-IP hashing for the waitlist. Any long random string; changing it later
# just orphans the old hashes.
WAITLIST_IP_SALT=

# --- Required only for cinematic-debut-manifesto ----------------------
# The only format with generation slots, and so the only one that spends on
# image/video generation: 6 slots x up to 3 paid Gemini attempts per build,
# plus Higgsfield. Leave these blank to run the other five formats at
# Anthropic-only cost.
GEMINI_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# --- Tuning -----------------------------------------------------------

# Build and render spawns share one semaphore. 2 suits a 4 vCPU box; a
# third simultaneous build queues rather than thrashing the CPU.
PIPELINE_MAX_CONCURRENT=2

# Per-user cap on build+render ATTEMPTS in a rolling 24h (see
# src/app/lib/quota.ts) — the invite gate controls who can spend on
# Anthropic/Gemini/Higgsfield, this bounds how much any one invited person
# can run up. Admins are exempt. Unset defaults to 10; an explicit 0 means
# unlimited.
PIPELINE_DAILY_LIMIT_PER_USER=10

# Global kill switch: set to 1 and `systemctl restart editable` to refuse
# every build/render immediately (503). An env var, not a DB flag, so it
# can't fail open if Neon is unreachable.
# PIPELINE_DISABLED=1

# Leave UNSET here. It exists to hide everything but the landing page and
# waitlist, and belongs on the Vercel marketing deploy, not this one.
# NEXT_PUBLIC_APP_ENABLED=false
